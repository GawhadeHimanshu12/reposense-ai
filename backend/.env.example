# Database
DATABASE_URL=postgresql://user:password@localhost:5432/reposense

# Redis
REDIS_URL=redis://localhost:6379/0
BLOCKLIST_TTL_SECONDS=86400

# Security
SECRET_KEY=your-secret-key-min-32-chars
JWT_SECRET_KEY=your-jwt-secret-key
REFRESH_TOKEN_SECRET=your-refresh-token-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Google OAuth
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_CALLBACK_URL=http://localhost:8000/api/v1/auth/google/callback

# GitHub OAuth (optional)
GITHUB_CLIENT_ID=your-github-client-id
GITHUB_CLIENT_SECRET=your-github-client-secret
GITHUB_CALLBACK_URL=http://localhost:8000/api/v1/auth/github/callback

# AI Providers (configure at least one)
DEFAULT_AI_PROVIDER=gemini

# Google Gemini (FREE)
GOOGLE_API_KEY=your-google-api-key
GEMINI_API_KEY=

# OpenAI (PAID - optional)
OPENAI_API_KEY=your-openai-key

# Anthropic Claude (PAID - optional)
ANTHROPIC_API_KEY=your-anthropic-key

# CORS
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,https://yourdomain.com

# Rate Limiting
RATE_LIMIT_PER_MINUTE=60
RATE_LIMIT_REPO_ANALYSIS_PER_DAY=3
RATE_LIMIT_FOLLOWUP_PER_DAY=10

# GitHub API
GITHUB_TOKEN=your-github-token-optional

# Application
APP_NAME=RepoSense AI
ENVIRONMENT=production
DEBUG=false
LOG_LEVEL=INFO
